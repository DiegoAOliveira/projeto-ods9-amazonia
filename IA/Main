
package amazonia;

import com.fasterxml.jackson.databind.JsonNode;

import java.util.List;

/**
 * IA de alertas: lê o histórico da área (sensores + ocorrências de moradores e agentes),
 * pede à Groq uma avaliação de risco ponderando a confiabilidade de cada fonte e,
 * se houver risco, cria o alerta e notifica os usuários da comunidade.
 */
public class AlertaIA {
    private static final int LIMITE_HISTORICO = 20;
    private static final double CONFIANCA_MINIMA = 0.5;

    private static final String SISTEMA = """
            Você é o sistema de alerta de infraestrutura de comunidades isoladas da Amazônia.
            Avalie o risco de UMA área com base no histórico (mais recente primeiro).
            Peso das fontes:
            - SENSOR automático: confiança alta.
            - Agente de saúde marcado como confiável: confiança alta.
            - Morador ou usuário não confiável: confiança baixa isoladamente; só eleve o risco se houver
              vários relatos parecidos ou confirmação de sensor/agente confiável.
            Considere tendência (piora ao longo do tempo) e recorrência, não só o último dado.
            Responda APENAS em JSON:
            {"risco":"NORMAL|ATENCAO|CRITICO","gravidade":"BAIXA|MEDIA|ALTA","confianca":0.0-1.0,
             "tipo":"título curto do alerta","justificativa":"1-2 frases",
             "mensagem_morador":"até 140 caracteres, linguagem simples, com o que fazer",
             "mensagem_gestor":"até 300 caracteres, técnica, com fontes e ação sugerida"}
            """;

    private final GroqClient groq;
    private final AmazoniaDao dao;
    private final HistoricoDao hist;
    private final Notificador notificador;

    public AlertaIA(GroqClient groq, AmazoniaDao dao, HistoricoDao hist, Notificador notificador) {
        this.groq = groq;
        this.dao = dao;
        this.hist = hist;
        this.notificador = notificador;
    }

    /** Chame após cada nova leitura de sensor ou ocorrência registrada. */
    public void avaliar(long areaId) throws Exception {
        String area = hist.tipoDaArea(areaId);
        List<HistoricoDao.Registro> registros = hist.historico(areaId, LIMITE_HISTORICO);
        if (registros.isEmpty()) return;

        JsonNode r = groq.pedirJson(SISTEMA, "Área: " + area + "\nHistórico:\n" + formatar(registros));

        String risco = r.path("risco").asText("NORMAL");
        double confianca = r.path("confianca").asDouble(0);
        System.out.printf("[IA] %s -> %s (confiança %.2f): %s%n", area, risco, confianca,
                r.path("justificativa").asText());

        if (risco.equals("NORMAL")) {
            dao.atualizarStatusArea(areaId, "NORMAL");
            return;
        }
        if (confianca < CONFIANCA_MINIMA) {
            System.out.println("[IA] Confiança baixa: aguardando confirmação de sensor ou agente confiável.");
            return;
        }

        String gravidade = r.path("gravidade").asText("MEDIA");
        dao.atualizarStatusArea(areaId, risco);
        if (hist.temAlertaAberto(areaId, gravidade)) return; // evita alerta duplicado

        String descricao = r.path("justificativa").asText() + String.format(" (confiança %.0f%%)", confianca * 100);
        long alertaId = dao.inserirAlerta(areaId, r.path("tipo").asText("Risco em " + area), descricao, gravidade);
        notificar(areaId, alertaId, risco, r);
    }

    private void notificar(long areaId, long alertaId, String risco, JsonNode r) throws Exception {
        String canal = risco.equals("CRITICO") ? "SMS" : "PUSH"; // crítico também por SMS (conectividade mínima)
        for (HistoricoDao.UsuarioAlvo u : hist.usuariosDaComunidade(hist.comunidadeDaArea(areaId))) {
            String msg = u.papel().equals("GESTOR")
                    ? r.path("mensagem_gestor").asText()
                    : r.path("mensagem_morador").asText();
            long notId = hist.inserirNotificacao(u.id(), alertaId, msg, canal);
            notificador.enviar(u, canal, msg);
            hist.marcarEnviada(notId);
        }
    }

    private String formatar(List<HistoricoDao.Registro> registros) {
        StringBuilder sb = new StringBuilder();
        for (HistoricoDao.Registro g : registros) {
            sb.append("- ").append(g.dataHora()).append(" | ");
            if (g.origem().equals("AUTOMATICO")) {
                sb.append("SENSOR | ").append(g.tipo()).append(": ").append(g.valor()).append(' ')
                        .append(g.unidade());
            } else {
                sb.append("RELATO | ").append(g.tipo()).append(" | por ").append(g.reportadoPor())
                        .append(" (").append(g.papel()).append(g.confiavel() ? ", CONFIÁVEL" : ", não confiável")
                        .append(')');
            }
            sb.append('\n');
        }
        return sb.toString();
    }
}
